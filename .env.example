# ====== ARUN — CoinDCX Futures Signal Bot — .env.example ======
# Copy to .env and fill in real values. NEVER commit .env.

# --- Brand / paper mode ---
ARUN_PAPER_MODE=true

# --- Telegram (optional; bot runs without but does not publish) ---
ARUN_TELEGRAM_BOT_TOKEN=
ARUN_TELEGRAM_CHAT_ID=
# Comma-separated Telegram user IDs authorised to issue /pause /reset etc.
ARUN_OPERATOR_WHITELIST=

# --- CoinDCX ---
# Public API needs no key. Futures API verification uses public endpoints.
ARUN_COINDCX_API_KEY=
ARUN_COINDCX_API_SECRET=

# --- External providers (all public/no-key by default) ---
ARUN_COINGLASS_API_KEY=
ARUN_FRED_API_KEY=

# --- Engine tuning ---
ARUN_LOOP_INTERVAL_SEC=5.0
ARUN_DECISION_INTERVAL_SEC=30.0
ARUN_SIGNAL_MIN_COOLDOWN_SEC=600.0
ARUN_ENTRY_VALIDITY_WINDOW_SEC=900.0

ARUN_MAX_OPEN_SIGNALS=3
ARUN_MAX_LEVERAGE=10.0
ARUN_DEFAULT_RISK_PCT=0.01
ARUN_DAILY_LOSS_KILL_PCT=0.03
ARUN_CONSECUTIVE_LOSS_LATCH=3

ARUN_RSS_WARNING_MB=350
ARUN_RSS_CRITICAL_MB=600
ARUN_LOG_LEVEL=INFO

# --- Storage ---
ARUN_SQLITE_PATH=data/arun.db
